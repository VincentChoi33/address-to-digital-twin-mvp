{
  "name": "address-to-digital-twin-preview-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run lint && vite build",
    "sample:sadang": "tsx src/core/runAddressTwin.ts --sample sadang",
    "export:sadang": "tsx src/core/runAddressTwin.ts --sample sadang",
    "prepare:deploy": "npm run export:sadang && npm run nvidia:package && npm run build && rm -rf dist/samples && mkdir -p dist/samples && cp -R src/samples/sadang_317_6 dist/samples/",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:omniverse": "tsx src/nvidia/exportOmniversePackage.ts",
    "nvidia:preflight": "tsx src/nvidia/runPreflight.ts",
    "nvidia:handoff": "tsx src/nvidia/packageHandoff.ts",
    "nvidia:package": "npm run export:omniverse && npm run nvidia:preflight && npm run nvidia:handoff"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/three": "^0.160.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.8"
  }
}
