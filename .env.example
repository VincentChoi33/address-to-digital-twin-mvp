# Optional. The MVP runs without keys by using Nominatim/procedural preview fallbacks.
# Juso normalizes Korean road/parcel addresses; VWorld converts the selected address to lon/lat.
JUSO_API_KEY=
VWORLD_API_KEY=

# Optional static/app tile preview settings.
# Leave unset for the app default: VWorld WMTS proxy when VWORLD_API_KEY exists, with procedural fallback.
# Set to procedural to force no external tile option; set to arcgis or custom for other live preview sources.
VITE_BASEMAP_MODE=
VITE_CUSTOM_TILE_URL=

# Optional Nominatim fallback. This is for occasional manual tests only, not bulk geocoding.
NOMINATIM_USER_AGENT=address-twin-preview-mvp/0.1 contact@example.com

# Optional NVIDIA-only runtime gates.
# These are not needed for local browser preview. They are required only when running the
# Omniverse/ovrtx/ovstream/Content Agents/SimReady path against real NVIDIA services.
NVIDIA_API_KEY=
NGC_API_KEY=
NVCF_API_KEY=
CONTENT_AGENTS_TOKEN=
CONTENT_AGENTS_MATERIAL_AGENT_BASE_URL=
CONTENT_AGENTS_PHYSICS_AGENT_BASE_URL=
CONTENT_AGENTS_OVRTX_BASE_URL=
OVRTX_RENDER_ENDPOINT=
OVSTREAM_SIGNALING_URL=
OMNIVERSE_STREAM_URL=
OVRTX_WEBRTC_URL=
SIMREADY_FOUNDATION_ROOT=
PHYSICAL_AI_SKILL_HUB_UPSTREAM_ROOT=
